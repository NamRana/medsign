# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql+asyncpg://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Gemini
GEMINI_API_KEY=your-gemini-api-key

# Frontend
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS (comma-separated origins for production)
CORS_ORIGINS=http://localhost:3000

# MedGemma (optional — for GPU-equipped servers)
MEDGEMMA_ENABLED=false
MEDGEMMA_MODEL_ID=google/medgemma-4b-it
HF_TOKEN=your-huggingface-token

# Monitoring
SENTRY_DSN=
POSTHOG_KEY=

# App
ENVIRONMENT=development
SECRET_KEY=generate-a-random-secret-here
